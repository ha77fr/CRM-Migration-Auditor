# Optional: defaults work without this file. Paths are relative to the project root.
AUDITOR_DATABASE_URL=sqlite:///./.data/auditor.db
AUDITOR_STORAGE_DIR=.data/uploads
AUDITOR_TASK_BACKEND=local
AUDITOR_AUTO_CREATE_SCHEMA=true
AUDITOR_BROKER_URL=redis://localhost:6379/0
AUDITOR_MAX_UPLOAD_BYTES=5242880
AUDITOR_MAX_ROWS=25000
AUDITOR_MAX_FINDINGS=1000
# Set a long random value to require X-API-Key on /api/v1 routes.
# This is a single-user development guard, NOT multi-tenant authentication.
AUDITOR_API_KEY=
